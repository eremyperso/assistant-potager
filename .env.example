# Copier ce fichier en .env.dev ou .env.prod et remplir les valeurs réelles
# NE PAS commiter .env.dev ou .env.prod

APP_ENV=dev

TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_ICI
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI

# [US-092 / CA3] Passerelle LLM — modèle par type d'appel. Toutes ces variables
# sont FACULTATIVES : non renseignées, chaque type retombe sur GROQ_MODEL (et la
# transcription sur GROQ_WHISPER_MODEL), soit le comportement actuel à
# l'identique. Les renseigner permet de router la classification sur un petit
# modèle rapide et le parsing/la synthèse sur le grand modèle — les quotas Groq
# étant comptés PAR MODÈLE, c'est le levier de répartition de capacité.
# GROQ_MODEL_CLASSIFICATION=
# GROQ_MODEL_PARSING=
# GROQ_MODEL_QUESTION=
# GROQ_MODEL_SYNTHESE=
# GROQ_MODEL_TRANSCRIPTION=

# [US-092 / CA12] Délai maximal par appel LLM (secondes) et plafond de la
# temporisation avant l'unique nouvelle tentative sur 429/5xx.
# GROQ_TIMEOUT_S=30
# GROQ_RETRY_MAX_S=2
DATABASE_URL=postgresql://potager_user:VOTRE_MOT_DE_PASSE@localhost/potager

# Authentification web JWT [US-044] — secret fort, jamais versionné
JWT_SECRET=VOTRE_SECRET_JWT_ICI
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Vérification d'e-mail à l'inscription [US-044 CA9-CA12] — API Brevo
# (https://app.brevo.com/settings/keys/api). Laisser vide en dev/test pour
# activer le mode dégradé (lien de vérification loggé au lieu d'un envoi réel).
BREVO_API_KEY=
EMAIL_FROM=noreply@assistant-potager.fr
EMAIL_FROM_NOM=Assistant Potager
# URL de base de la PWA pour construire le lien de vérification (doit pointer
# vers le frontend réel en prod, ex. https://assistant-potager.netlify.app)
FRONTEND_URL=http://localhost:3000

# Connexion « Continuer avec Google » [US-090] — OpenID Connect, flux
# Authorization Code + PKCE. Identifiants créés dans la console Google Cloud
# (APIs & Services → Identifiants → ID client OAuth 2.0, type « Application Web »).
# Laisser vide pour masquer complètement le connecteur (CA4) : le dev local et
# les tests fonctionnent sans compte Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Liste blanche des URI de redirection, séparées par des virgules (CA8). Elles
# pointent sur l'API — jamais sur le frontend — et doivent être déclarées à
# l'identique dans la console Google Cloud, environnement par environnement.
GOOGLE_REDIRECT_URIS=http://localhost:8000/auth/oauth/google/callback
