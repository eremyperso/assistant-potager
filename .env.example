# Copier ce fichier en .env.dev ou .env.prod et remplir les valeurs réelles
# NE PAS commiter .env.dev ou .env.prod

APP_ENV=dev

TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_ICI
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
# Adresse de l'API Groq (absente : celle du SDK Groq) et modèles de repli de la plateforme.
# GROQ_BASE_URL=https://api.groq.com
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Niveau de raisonnement envoyé aux modèles Groq qui raisonnent : low | medium | high | aucun.
# GROQ_REASONING_EFFORT=low

# [US-092 / CA3] Passerelle LLM — modèle par type d'appel. Toutes ces variables
# sont FACULTATIVES : non renseignées, chaque type retombe sur GROQ_MODEL (et la
# transcription sur GROQ_WHISPER_MODEL), soit le comportement actuel à
# l'identique. Les renseigner permet de router la classification sur un petit
# modèle rapide et le parsing/la synthèse sur le grand modèle — les quotas Groq
# étant comptés PAR MODÈLE, c'est le levier de répartition de capacité.
# GROQ_MODEL_CLASSIFICATION=
# GROQ_MODEL_PARSING=
# GROQ_MODEL_QUESTION=
# GROQ_MODEL_SYNTHESE=
# GROQ_MODEL_TRANSCRIPTION=
#
# [US-233 / CA2] Modèle de l'AGENT INTERPRÉTEUR (appel d'outils typés), distinct
# de celui de la classification. Il doit gérer les appels d'outils : la passerelle
# le détecte au premier appel et le mémorise. Se choisit sur la mesure
# `python tools/evaluer_agent.py` (rapport dans docs/EPIC - AGENT INTERPRETEUR/).
# GROQ_MODEL_AGENT=
#
# Fournisseur Mistral : un modèle préfixé `mistral/` est servi par l'API Mistral
# (clé créée sur console.mistral.ai), les autres types restent sur Groq. Tout
# changement de modèle de l'agent se remesure avec tools/evaluer_agent.py.
# MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_ICI
# Adresse de l'API Mistral, OBLIGATOIRE avec la clé : aucune adresse n'est écrite dans le code.
# MISTRAL_BASE_URL=https://api.mistral.ai
# [US-287 / CA2] Cible de la bascule « agent d'abord » (décision D14 du 02/11/2026) :
# Mistral Small 4, même justesse que le 8B et le 14B, p95 de 2,6 s, le moins cher
# grâce au cache. Le même modèle rédige les messages spontanés.
# GROQ_MODEL_AGENT=mistral/mistral-small-2603
# GROQ_MODEL_COMPAGNON_SIGNAL=mistral/mistral-small-2603
#
# [US-299] Compagnon vocal de la PWA (Voxtral, Mistral — MISTRAL_API_KEY requise).
# Deux types d'appel à part, comptés dans conso_tokens (la dictée en secondes d'audio,
# la voix en caractères envoyés). Distincts de GROQ_MODEL_TRANSCRIPTION : le bot
# Telegram garde Groq Whisper. Sans clé Mistral, la PWA dit « la voix est
# indisponible » et le texte fonctionne toujours.
# Jamais de commentaire sur la ligne d'une valeur : il en ferait partie (et `source` en
# bash, au déploiement, le refuserait).
# Dictée (audio → texte) :
# GROQ_MODEL_DICTEE=mistral/voxtral-mini-transcribe-3-0
# Voix (texte → MP3) :
# GROQ_MODEL_VOIX=mistral/voxtral-mini-tts-3-0
# VOIX_FORMATS_A_CONVERTIR : formats de dictée convertis en WAV par FFmpeg avant envoi
# (ex. mp4,m4a si Mistral refuse l'audio de Safari). Vide par défaut : webm et ogg passent.
# VOIX_FORMATS_A_CONVERTIR=
# [US-300] Voix de Gaston tant que le jardinier n'en a pas choisi une (défaut : voice_592, Marie).
# VOIX_PAR_DEFAUT=voice_592
# [US-302] Dictée de la PWA : arrêt automatique (s), poids maximal du fichier (Ko), dictées
# par jardinier et par jour (au-delà : « Limite de dictées du jour atteinte », le clavier reste).
# VOIX_DICTEE_DUREE_MAX_S=60
# VOIX_DICTEE_TAILLE_MAX_KO=3072
# VOIX_PLAFOND_DICTEES_JOUR=100
# [US-303] Résumé parlé d'une réponse de Gaston (1 à 2 phrases) : plafond en caractères, et
# modèle de l'appel « oral » (défaut : celui de l'agent).
# VOIX_ORAL_MAX_CARACTERES=300
# GROQ_MODEL_ORAL=
# [US-304] Lectures à voix haute des réponses de Gaston par jardinier et par jour (au-delà :
# « Limite de lectures du jour atteinte », les réponses restent lisibles à l'écran).
# VOIX_PLAFOND_LECTURES_JOUR=100
#
# Autres fournisseurs, compatibles OpenAI (OpenAI, serveur de voix local, hébergeur…),
# déclarés ici SANS code. Le préfixe `<nom>/` d'un modèle désigne le fournisseur, comme
# `mistral/`. L'URL est celle sous laquelle le fournisseur sert /chat/completions (OpenAI :
# https://api.openai.com/v1 ; Gemini : https://generativelanguage.googleapis.com/v1beta/openai,
# chat seulement, ni dictée ni voix à ce format). Noms interdits, car
# déjà espaces de modèles Groq : openai, meta-llama, qwen, moonshotai, groq… (d'où `oai`).
# Valable pour tous les types d'appel (dictée, voix, oral, agent…), un par un.
# FOURNISSEURS_COMPATIBLES=oai
# FOURNISSEUR_OAI_BASE_URL=https://api.openai.com/v1
# FOURNISSEUR_OAI_API_KEY=sk-VOTRE_CLE
# GROQ_MODEL_DICTEE=oai/gpt-4o-mini-transcribe
# GROQ_MODEL_VOIX=oai/gpt-4o-mini-tts
# Voix proposées dans « Mon compagnon » (id:Nom[:genre], séparées par des virgules).
# Obligatoire hors Mistral (sinon seule VOIX_PAR_DEFAUT est proposée), et VOIX_PAR_DEFAUT
# doit en faire partie. Une voix choisie absente de la liste retombe sur la voix par défaut.
# VOIX_CATALOGUE=nova:Nova:female,shimmer:Shimmer:female,onyx:Onyx:male
# VOIX_PAR_DEFAUT=nova
#
# [US-233 / CA5, US-235 / CA12] Agent interpréteur, branché à la place du repli
# modèle de l'interpréteur de commandes. Lu à chaque phrase : changer de mode
# est un réglage, sans redéploiement de code.
#   AGENT_MODE : off (défaut, comportement d'avant l'agent)
#              | ombre (le bot répond comme avant ; ce que l'agent aurait proposé
#                est journalisé dans routage_logs, issue_interpretation='ombre')
#              | actif (l'agent propose ; repli silencieux sur l'ancien chemin
#                s'il est indisponible).
#              | prioritaire (la cible, US-287 : toute phrase libre va d'abord
#                à l'agent, avant les règles ET les raccourcis à mots-clés du bot
#                (annuler, godets, déplacer, note) ; catalogue complet et savoir.
#                Sur quota ou panne de l'agent, les règles et les raccourcis
#                reprennent la main. En dev d'abord ; la prod suit après une
#                semaine d'usage réel sans couperet au journal, et seulement si
#                `python tools/evaluer_dialogues.py --mode prioritaire` franchit
#                les seuils de ANALYSE_MESURE_AGENT_D_ABORD.md §7).
#                Une valeur inconnue retombe sur off. Passer en actif sur la
#                lecture du journal et de `python tools/evaluer_interpreteur_agent.py`.
#   AGENT_MAX_TOURS : borne de la boucle conversationnelle de l'agent (défaut 6, US-257).
# AGENT_MODE=off
# AGENT_MODE=prioritaire
# AGENT_MAX_TOURS=6
#
# Exemple — bascule sur groq/compound-mini (système agentique Groq avec
# recherche web / exécution de code intégrées côté serveur, un seul appel
# d'outil par requête) : la passerelle sait déjà ne pas lui envoyer
# `reasoning_effort` (non supporté, ce n'est pas un modèle de raisonnement).
# GROQ_MODEL_QUESTION=groq/compound-mini

# [US-092 / CA12] Délai maximal par appel LLM (secondes) et plafond de la
# temporisation avant l'unique nouvelle tentative sur 429/5xx.
# GROQ_TIMEOUT_S=30
# GROQ_RETRY_MAX_S=2
DATABASE_URL=postgresql://potager_user:VOTRE_MOT_DE_PASSE@localhost/potager

# Authentification web JWT [US-044] — secret fort, jamais versionné
JWT_SECRET=VOTRE_SECRET_JWT_ICI
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Vérification d'e-mail à l'inscription [US-044 CA9-CA12] — API Brevo
# (https://app.brevo.com/settings/keys/api). Laisser vide en dev/test pour
# activer le mode dégradé (lien de vérification loggé au lieu d'un envoi réel).
BREVO_API_KEY=
EMAIL_FROM=noreply@assistant-potager.fr
EMAIL_FROM_NOM=Assistant Potager
# URL de base de la PWA pour construire le lien de vérification (doit pointer
# vers le frontend réel en prod, ex. https://assistant-potager.netlify.app)
FRONTEND_URL=http://localhost:3000

# Canal MCP — assistants IA externes [US-290]. Adresse PUBLIQUE de l'API (sans
# « / » final) : émetteur OAuth et URL du connecteur ({MCP_URL_PUBLIQUE}/mcp).
# En prod : https://potager.eremy.fr. Plafonds par connecteur et durées de vie.
MCP_URL_PUBLIQUE=http://localhost:8000
# MCP_QUOTA_MINUTE=30
# MCP_QUOTA_JOUR=1000
# MCP_ACCES_TTL_MIN=60
# MCP_RAFRAICHISSEMENT_TTL_JOURS=30
# MCP_PERSONNEL_TTL_JOURS=90

# Connexion « Continuer avec Google » [US-090] — OpenID Connect, flux
# Authorization Code + PKCE. Identifiants créés dans la console Google Cloud
# (APIs & Services → Identifiants → ID client OAuth 2.0, type « Application Web »).
# Laisser vide pour masquer complètement le connecteur (CA4) : le dev local et
# les tests fonctionnent sans compte Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Liste blanche des URI de redirection, séparées par des virgules (CA8). Elles
# pointent sur l'API — jamais sur le frontend — et doivent être déclarées à
# l'identique dans la console Google Cloud, environnement par environnement.
GOOGLE_REDIRECT_URIS=http://localhost:8000/auth/oauth/google/callback

# [US-097 / CA7] E-mail du compte administrateur de la plateforme — seul compte
# autorisé à consulter GET /admin/routage/*. Laisser vide désactive ces
# endpoints (403 systématique), aucun repli implicite.
ADMIN_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════
# [US-267] Messages spontanés du compagnon dans Telegram
# ═══════════════════════════════════════════════════════════════════════════
# Le veilleur détecte toujours (gel, levée non notée, échéance de lot…) ; ces
# réglages décident de ce qui PART dans Telegram. Exige la migration v66.
#
# COMPAGNON_PROACTIF : « oui » = le distributeur envoie les messages ; toute
# autre valeur (défaut « non ») = rien ne part. C'est le retour arrière, sans
# redéploiement de code. Redémarrer le bot après modification.
COMPAGNON_PROACTIF=non
#
# GROQ_MODEL_COMPAGNON_SIGNAL : modèle qui rédige ces messages (type d'appel
# `compagnon_signal`, compté à part dans conso_tokens). Vide = le modèle de
# l'agent (GROQ_MODEL_AGENT). Un préfixe `mistral/` utilise l'API Mistral.
# En panne ou infidèle, le gabarit du code part à sa place.
GROQ_MODEL_COMPAGNON_SIGNAL=
#
# [US-273] Analyse approfondie (bouton « Approfondir » de la PWA, /approfondir du bot) : une
# boucle de LECTURE seule. GROQ_MODEL_ANALYSE : son modèle (type d'appel `analyse`, compté à
# part) ; vide = le modèle de l'agent. C'est l'usage où une montée de modèle se justifie le
# plus. ANALYSE_MAX_TOURS : tours de lecture au plus (défaut 6). ANALYSE_MAX_JETONS : cumul de
# jetons au-delà duquel l'analyse cesse de lire et rend ce qu'elle a (défaut 20000).
GROQ_MODEL_ANALYSE=
# ANALYSE_MAX_TOURS=6
# ANALYSE_MAX_JETONS=20000

# ── Mode test conversationnel (US-288) — à mettre dans .env.test, jamais en dev ni en prod ──
# Voir docs/domaines/tests-conversationnels.md. Le bot de test a SON token, SA base
# (le nom doit contenir « test ») et le même .env.test sert au bot et au harnais.
#
# APP_ENV=test
# TELEGRAM_BOT_TOKEN=<token du bot de test, BotFather>
# DATABASE_URL=postgresql://…/potager_test
# AGENT_MODE=prioritaire
# COMPAGNON_PROACTIF=non
#
# Compte Telegram dédié aux tests (my.telegram.org) :
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_TEST_BOT_USERNAME=<nom_du_bot_de_test>
# TELEGRAM_TEST_SESSION=<ligne produite par `python -m tests_conv session` — SECRET>
#
# Réglages du pilote (défauts entre parenthèses) :
# CONV_QUIESCENCE_S=5          # silence qui clôt un tour
# CONV_PREMIERE_REPONSE_S=45   # attente de la première réponse
# CONV_PLAFOND_TOUR_S=120      # durée maximale d'un tour
# CONV_PAUSE_S=1.5             # délai entre deux envois (limites Telegram)

